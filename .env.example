# =========================================================================
# Transcript sources — at least one of ENABLE_FOLDER_WATCH / ENABLE_FIREFLIES_API_SOURCE
# must be enabled.
# =========================================================================

# Primary source: watch this local folder for new .md transcript files that Fireflies
# auto-saves there. Set ENABLE_FOLDER_WATCH=false to disable.
ENABLE_FOLDER_WATCH=true
WATCH_FOLDER=/path/to/fireflies/export/folder/Transcripts

# Optional: path to Fireflies' own native "Summaries" export folder (a sibling of the
# "Transcripts" folder set above in WATCH_FOLDER). Fireflies pairs each transcript file
# "<Title>-transcript-<timestamp>.md" with a summary file "<Title>-summary-<timestamp>.md"
# containing its own AI summary plus the Fireflies meeting ID/link and date. When set, this is
# used ONLY to reliably resolve each transcript's Fireflies ID/title/date (for accurate folder
# naming, optional deletion, and ID-based dedup) — its summary text is never read as additional
# analysis input; Copilot CLI analysis always stays scoped strictly to the raw transcript file.
SUMMARY_FOLDER=/path/to/fireflies/export/folder/Summaries

# Secondary/optional source: fetch transcripts via the Fireflies GraphQL API. Also used
# (independent of this flag, whenever FIREFLIES_API_KEY is set) to resolve a Fireflies
# transcript ID by title+date for folder-sourced files that don't embed one, and to perform
# deletion (see FIREFLIES_AUTO_DELETE_AFTER_PROCESSING below).
ENABLE_FIREFLIES_API_SOURCE=false

# Fireflies.ai API key (Settings -> Developer Settings -> API Key). Required if
# ENABLE_FIREFLIES_API_SOURCE or FIREFLIES_AUTO_DELETE_AFTER_PROCESSING is true.
FIREFLIES_API_KEY=

# How often (in minutes) the "run" command performs a full sync pass.
POLL_INTERVAL_MINUTES=15

# =========================================================================
# Output
# =========================================================================

# One subfolder per meeting is created here:
# OUTPUT_DIR/<YYYY-MM-DD>--<safe-title>--<id>/ containing transcript.md, note.md,
# diagrams/*.md (if any), and keywords.json.
OUTPUT_DIR=./notes

# =========================================================================
# Copilot CLI (used for all analysis — no OpenAI/LLM API key needed)
# =========================================================================

# Optional: Copilot CLI model to use (e.g. "claude-sonnet-4.5", "gpt-5-mini").
# Defaults to "auto" (let the CLI pick its configured default model).
COPILOT_MODEL=auto

# Optional: name/path of the Copilot CLI executable if it's not called "copilot"
# or isn't on PATH. Defaults to "copilot". Requires `copilot login` beforehand.
COPILOT_EXECUTABLE=copilot

# =========================================================================
# Fireflies deletion (destructive, irreversible — opt-in, disabled by default)
# =========================================================================

# If true, after a meeting is fully and successfully processed (transcript copied, analysis
# written, vocabulary updated), the agent deletes it from Fireflies via the API. Only attempted
# when a Fireflies transcript ID could be resolved (embedded in the file or matched by
# title+date) — never guessed. Requires FIREFLIES_API_KEY.
FIREFLIES_AUTO_DELETE_AFTER_PROCESSING=false

# =========================================================================
# Optional exports (both disabled by default)
# =========================================================================

# Copies each processed meeting's output folder into an Obsidian vault subfolder.
ENABLE_OBSIDIAN_EXPORT=false
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault
OBSIDIAN_SUBFOLDER=Meetings

# Creates one Notion page per meeting in the configured database via the Notion API.
ENABLE_NOTION_EXPORT=false
NOTION_API_TOKEN=
NOTION_DATABASE_ID=
